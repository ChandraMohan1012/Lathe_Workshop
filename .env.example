# Next.js Site Configuration
NEXT_PUBLIC_SITE_URL=https://lathepattarai.com
NEXT_PUBLIC_DEMO_MODE=true

# Cryptographic Session & Admin Passkey Secrets (REQUIRED - Use strong random 64-character strings)
SESSION_SECRET=YOUR_SECURE_RANDOM_SESSION_SECRET_HERE
ADMIN_SECRET_KEY=YOUR_SECURE_ADMIN_PASSKEY_HERE

# Supabase Authentication & Storage (Required for DB RLS & photo uploads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
